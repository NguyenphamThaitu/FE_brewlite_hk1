{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2022", "declaration": false,
    "removeComments": true, "emitDecoratorMetadata": true, "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true, "esModuleInterop": true, "sourceMap": false,
    "outDir": "./dist", "baseUrl": "./", "incremental": false, "skipLibCheck": true,
    "strict": true, "strictPropertyInitialization": false, "forceConsistentCasingInFileNames": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
