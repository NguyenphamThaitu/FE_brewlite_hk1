{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": "../apps/web",
    "paths": {
      "@/*": ["src/*"],
      "*": ["*", "node_modules/*"]
    },
    "typeRoots": ["../apps/web/node_modules/@types"]
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
