@startuml usecase-overview
' BrewLite - So do use-case tong quat (Task 1.2)
' Mo ta: docs/requirements/use-case-overview.md
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FFF8EE
  BorderColor #8A5A2B
  BackgroundColor<<mở rộng>> #F2F2F2
  BorderColor<<mở rộng>> #888888
}

actor "Khách vãng lai" as Guest
actor "Khách hàng" as Customer
actor "Nhân viên quầy" as Staff
actor "Quản lý cửa hàng" as Manager
actor "Payment Gateway" as Pay <<hệ thống>>

Customer -|> Guest
Manager -|> Staff

rectangle "Hệ thống BrewLite" {
  usecase "UC-02 Xem menu" as UC02
  usecase "UC-03 Xem chi tiết,\nchọn size và topping" as UC03
  usecase "UC-04 Quản lý giỏ hàng" as UC04
  usecase "UC-05 Đăng ký" as UC05
  usecase "UC-06 Đăng nhập" as UC06
  usecase "UC-01 Đặt và thanh toán\nđơn hàng" as UC01
  usecase "UC-07 Xem lịch sử\nđơn hàng" as UC07
  usecase "UC-08 Theo dõi\ntrạng thái đơn" as UC08
  usecase "UC-09 Hủy đơn" as UC09
  usecase "UC-11 Cập nhật\ntrạng thái đơn" as UC11
  usecase "Xác thực người dùng" as AUTH
  usecase "UC-10 Áp mã khuyến mãi" as UC10 <<mở rộng>>
  usecase "UC-12 Quản lý menu" as UC12 <<mở rộng>>
}

Guest -- UC02
Guest -- UC03
Guest -- UC04
Guest -- UC05
Guest -- UC06

Customer -- UC01
Customer -- UC07
Customer -- UC09

Staff -- UC11
Manager -- UC12

UC01 -- Pay

UC01 ..> AUTH : <<include>>
UC07 ..> AUTH : <<include>>
UC09 ..> AUTH : <<include>>
UC11 ..> AUTH : <<include>>
UC08 ..> UC07 : <<extend>>
UC10 ..> UC01 : <<extend>>
@enduml
