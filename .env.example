# =========================================================
# BrewLite - biến môi trường dùng cho Docker Compose ở local
# Sao chép file này thành .env tại thư mục gốc repository.
# Các giá trị bên dưới chỉ là mẫu cho môi trường phát triển.
# Không dùng các giá trị này cho production.
# =========================================================

# PostgreSQL (service db trong docker-compose.yml)
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=change-this-local-postgres-password
POSTGRES_DB=brewlite

# Backend API
# Thay bằng chuỗi ngẫu nhiên riêng, tối thiểu 32 ký tự.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGIN=http://localhost:3000
AUTO_SEED=true
# Mật khẩu ban đầu cho tài khoản STAFF do seed tạo ở môi trường local.
STAFF_PASSWORD=change-this-local-staff-password

# Frontend: URL này được truyền vào lúc build Next.js.
# Trình duyệt của người dùng phải truy cập được địa chỉ này.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Tự hủy đơn chưa thanh toán quá hạn và hoàn kho.
ORDER_PAYMENT_TIMEOUT_MINUTES=15
# Đặt 0 để tắt tác vụ quét định kỳ.
ORDER_EXPIRY_CHECK_INTERVAL_SECONDS=60

# VNPay sandbox (không bắt buộc; Ví/Thẻ mô phỏng không cần các biến này).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Frontend có route nhận kết quả VNPay tại /payment/result.
VNPAY_RETURN_URL=http://localhost:3000/payment/result

# Lưu ý:
# - Docker Compose tự tạo DATABASE_URL nội bộ cho API từ ba biến POSTGRES_*.
# - PORT và JWT_EXPIRES_IN được cấu hình mặc định trong ứng dụng/ở mẫu
#   apps/api/.env.example khi chạy API trực tiếp, không cần khai báo ở đây.
